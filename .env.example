# Copier ce fichier en .env.local et remplir les valeurs

# Adresse publique du site (pour Google, les aperçus WhatsApp et les IA)
NEXT_PUBLIC_SITE_URL=https://mistsandscents.com

# Clé secrète pour ouvrir le tableau de bord /admin
# (en ligne : à régler dans cPanel > Setup Node.js App > Environment variables)
ADMIN_KEY=choisir-une-longue-cle-secrete

# Dossier des statistiques (facultatif, défaut : .data/ dans le projet)
# En ligne sur o2switch : un dossier HORS de l'application, ex. /home/<compte>/mists-data
# DATA_DIR=
